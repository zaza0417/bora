
# ---------- Backend (lido pelo app/config.py) ----------
AMBIENTE=dev
URL_PUBLICA_FRONT=http://localhost:4200
URL_PUBLICA_API=http://localhost:8000
CORS_ORIGENS=["http://localhost:4200"]

# Supabase → Project Settings → Database → Connection pooling (transaction mode)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
# Só se o projeto usar JWT legado (HS256); com chaves assimétricas deixe vazio
# Service role (nunca no front!) — Project Settings → API
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHAVE_CRIPTOGRAFIA=

# Mercado Pago → Suas integrações → sua aplicação
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
MP_TAXA_PIX=0.0099

# Evolution API
EVOLUTION_URL=http://localhost:8081
# Endereço da API visto de dentro do container da Evolution (local: host.docker.internal)
EVOLUTION_WEBHOOK_BASE=http://host.docker.internal:8000
EVOLUTION_WEBHOOK_SECRET=troque-por-um-segredo-aleatorio
EVOLUTION_API_KEY=troque-por-uma-chave-longa-e-aleatoria
