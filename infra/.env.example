# ---------- Domínio da API (aponte um DNS A para o IP da VM) ----------
API_DOMINIO=api.seudominio.com.br

# ---------- Backend (lido pelo app/config.py) ----------
AMBIENTE=prod
URL_PUBLICA_FRONT=https://seuapp.vercel.app
URL_PUBLICA_API=https://api.seudominio.com.br
CORS_ORIGENS=["https://seuapp.vercel.app"]

# Supabase → Project Settings → Database → Connection pooling (transaction mode)
DATABASE_URL=postgresql+asyncpg://postgres.SEU_PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://SEU_PROJETO.supabase.co
# Só se o projeto usar JWT legado (HS256); com chaves assimétricas deixe vazio
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHAVE_CRIPTOGRAFIA=

# Mercado Pago → Suas integrações → sua aplicação
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
MP_TAXA_PIX=0.0099

# Evolution API
EVOLUTION_URL=http://evolution:8080
EVOLUTION_WEBHOOK_SECRET=troque-por-um-segredo-aleatorio
EVOLUTION_API_KEY=troque-por-uma-chave-longa-e-aleatoria
EVOLUTION_DB_SENHA=troque-esta-senha
